<section class="hero is-medium" id="hero">
  <div class="hero-body">
    <div class="container">
      <figure class="image is-128x128 mb-5">
        <%= image_tag "ronald.jpg", class: "is-rounded", alt: "Ronald Langeveld", style: "object-fit: cover; object-position: top; width: 128px; height: 128px;" %>
      </figure>
      <h1 class="title is-1 mb-2">
        Ronald Langeveld
      </h1>
      <p class="subtitle is-4 has-text-grey mb-4">
        Senior Full Stack Software Engineer · 8+ years
      </p>
      <p class="is-size-5 has-text-grey-dark mb-5" style="max-width: 640px;">
        I build and ship production systems with React, Node.js, Python, and Rails — most recently a Product Engineer at Ghost.
      </p>

      <div class="buttons mb-6">
        <a href="https://calendar.app.google/qGDs2ijrYeASVriL6" target="_blank" rel="noopener" class="button is-dark is-medium">
          Book an intro call
        </a>
        <a href="/ronald-langeveld-resume.pdf" download="Ronald-Langeveld-Resume.pdf" class="button is-dark is-outlined is-medium">
          Download résumé
        </a>
      </div>

      <div class="columns is-mobile is-multiline is-vcentered mt-4">
        <% logos.each do |logo| %>
          <div class="column is-narrow py-3 pr-5">
            <%= image_tag logo[:src], alt: logo[:alt], class: "brand-logo", width: 120, height: 40 %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
